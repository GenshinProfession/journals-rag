ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://journals:journer@postgres:5432/journals_rag
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AI_GATEWAY_BASE_URL=https://relay.example.com
AI_GATEWAY_API_KEY=replace-me
AI_GATEWAY_CHAT_API_KEY=
AI_GATEWAY_NAMED_API_KEYS={}
AI_GATEWAY_BALANCE_QUERY_URLS=["https://chaxun.wlai.vip/","https://cx.tpkcur.click/"]
BILLING_RESERVE_CEILING_CENTS=50000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
UPLOAD_ROOT=/data/uploads
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_EXTENSIONS=[".pdf",".txt",".md",".text"]
# Development can create tables on startup; set false in production and run Alembic.
BOOTSTRAP_CREATE_SCHEMA=true
# Optional: create a zero-cost development model if the model catalog is empty
BOOTSTRAP_DEMO_MODEL=true
# Optional: create first admin on startup if username is not taken
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
