      "keywords": [
        "附录",
        "appendix"
      ],
      "format": {
        "font": "宋体",
        "sizePt": 12,
        "alignment": "both"
      }
    }
  },
  "nodeTypes": {
    "标题": {
      "type": "heading",
      "levels": [
        1,
        2,
        3,
        4
      ],
      "format": {
        "font": "黑体",
        "bold": true
      }
    },
    "正文": {
      "type": "paragraph",
      "format": {
        "font": "宋体",
        "sizePt": 12,
        "alignment": "both"
      }
    },
    "表格": {
      "type": "table",
      "format": {
        "border": "single",
        "padding": "6px"
      }
    },
    "图片": {
      "type": "image",
      "format": {
        "maxWidth": "100%",
        "maxHeight": "200px"
      }
    }
  },
  "zoneTypes": {
    "封面": {
      "type": "cover",
      "children": [
        "标题",
        "正文"
      ]
    },
    "目录": {
      "type": "toc",
      "children": [
        "标题",
        "正文"
      ]
    },
    "摘要": {
      "type": "abstract",
      "children": [
        "标题",
        "正文",
        "关键词"
      ]
    },
    "正文": {
      "type": "body",
      "children": [
        "标题",
        "正文",
        "表格",
        "图片"
      ]
    },
    "致谢": {
      "type": "acknowledgments",
      "children": [
        "标题",
        "正文"
      ]
    },
    "参考文献": {
      "type": "references",
      "children": [
        "正文"
      ]
    },
    "附录": {
      "type": "appendix",
      "children": [
        "标题",
        "正文",
        "表格",
        "图片"
      ]
    }
  },
