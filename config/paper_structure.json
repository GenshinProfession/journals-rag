    "封面": {
      "aliases": [
        "Cover",
        "封面页",
        "title page",
        "封皮"
      ],
      "type": "section",
      "required": true,
      "identifyBy": "content",
      "keywords": [
        "学校",
        "学院",
        "专业",
        "学号",
        "姓名",
        "指导教师",
        "毕业设计",
        "毕业论文"
      ],
      "format": {
        "font": "黑体",
        "sizePt": 22,
        "bold": true,
        "alignment": "center"
      }
    },
    "目录": {
      "aliases": [
        "Table of Contents",
        "目录页",
        "Contents",
        "目  录"
      ],
      "type": "section",
      "required": false,
      "identifyBy": "keyword",
      "keywords": [
        "目录",
        "contents"
      ],
      "format": {
        "font": "宋体",
        "sizePt": 12,
        "alignment": "left"
      }
    },
    "中文摘要": {
      "aliases": [
        "摘要",
        "摘  要",
        "中文摘要",
        "内容提要",
        "abstract_cn"
      ],
